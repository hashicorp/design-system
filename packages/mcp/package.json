{
  "name": "@hashicorp/design-system-mcp",
  "version": "0.1.0",
  "description": "Helios Design System MCP server",
  "keywords": [
    "hashicorp",
    "helios",
    "design-system",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hashicorp/design-system.git",
    "directory": "packages/mcp"
  },
  "license": "MPL-2.0",
  "author": "HashiCorp Design Systems <design-systems@hashicorp.com>",
  "type": "module",
  "bin": {
    "helios-design-system-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs-catalog.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm tsc",
    "lint": "pnpm eslint --quiet .",
    "test": "pnpm vitest run --dir tests",
    "test:watch": "pnpm vitest --dir tests",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && pnpm tsc --project tsconfig.build.json",
    "prepublishOnly": "pnpm build && pnpm test:dist-files",
    "test:dist-files": "node scripts/check-dist-files.mjs",
    "build:watch": "pnpm tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "serve": "node ./dist/index.js",
    "serve:watch": "node --watch --watch-path=./dist --watch-preserve-output ./dist/index.js",
    "start": "pnpm build && concurrently --kill-others-on-fail --names build,server \"pnpm build:watch\" \"pnpm serve:watch\"",
    "inspect": "npx -y @modelcontextprotocol/inspector node --watch --watch-path=./dist --watch-preserve-output ./dist/index.js",
    "start:dev": "pnpm build && concurrently --kill-others-on-fail --names build,inspector \"pnpm build:watch\" \"pnpm inspect\"",
    "catalog:docs": "node ./scripts/build-docs-catalog/index.mjs"
  },
  "dependencies": {
    "@hashicorp/design-system-components": "workspace:^6.5.0",
    "@hashicorp/design-system-tokens": "workspace:^5.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@hashicorp/flight-icons": "workspace:^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.3",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}

{
  "name": "@hashicorp/ember-template-lint-plugin-hds-evals",
  "version": "0.0.0",
  "private": true,
  "description": "Evaluation harness for the HDS template lint plugin",
  "type": "module",
  "scripts": {
    "eval": "node run.mjs",
    "format": "prettier . --cache --write",
    "lint": "eslint . && prettier . --cache --check",
    "lint:fix": "eslint . --fix && pnpm format",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hashicorp/ember-template-lint-plugin-hds": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@hashicorp/design-system-components": "workspace:^6.5.0",
    "@types/node": "^22.10.2",
    "ember-template-lint": "^7.7.0",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}

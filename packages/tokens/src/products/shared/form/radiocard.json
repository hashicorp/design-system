{
  "form": {
    "radio-card-group": {
      "gap": {
        "$type": "dimension",
        "$value": "16",
        "unit": "px"
      }
    },
    "radio-card": {
      "border": {
        "width": {
          "$type": "dimension",
          "$value": "1",
          "unit": "px"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{border.radius.medium}",
          "unit": "px"
        },
        "color": {
          "default": {
            "$type": "color",
            "$value": "{surface.color.primary}",
            "$modes": {
              "default": "{surface.color.primary}",
              "cds-g0": "transparent",
              "cds-g10": "transparent",
              "cds-g90": "transparent",
              "cds-g100": "transparent"
            }
          },
          "focus": {
            "$type": "color",
            "$value": "{focus.color.action.internal}",
            "$modes": {
              "default": "{focus.color.action.internal}",
              "cds-g0": "pink",
              "cds-g10": "pink",
              "cds-g90": "pink",
              "cds-g100": "pink"
            }
          },
          "default-checked": {
            "$type": "color",
            "$value": "{core.color.blue-300}",
            "$modes": {
              "default": "{core.color.blue-300}",
              "cds-g0": "pink",
              "cds-g10": "pink",
              "cds-g90": "pink",
              "cds-g100": "pink"
            }
          }
        }
      },
      "content-padding": {
        "$type": "dimension",
        "$value": "24",
        "unit": "px",
        "$modes": {
          "default": "24",
          "cds-g0": "16",
          "cds-g10": "16",
          "cds-g90": "16",
          "cds-g100": "16"
        }
      },
      "control": {
        "padding": {
          "$type": "dimension",
          "$value": "8",
          "unit": "px"
        },
        "size": {
          "$type": "dimension",
          "$value": "16",
          "unit": "px"
        }
      },
      "description": {
        "typography": {
          "font-size": {
            "$type": "font-size",
            "$value": "13",
            "unit": "px",
            "$modes": {
              "default": "13",
              "cds-g0": "14",
              "cds-g10": "14",
              "cds-g90": "14",
              "cds-g100": "14"
            }
          }
        }
      },
      "item-label": {
        "typography": {
          "font-size": {
            "$type": "font-size",
            "$value": "18",
            "unit": "px",
            "$modes": {
              "default": "18",
              "cds-g0": "14",
              "cds-g10": "14",
              "cds-g90": "14",
              "cds-g100": "14"
            }
          },
          "font-weight": {
            "$type": "font-weight",
            "$value": "{typography.font-weight.bold}",
            "$modes": {
              "default": "{typography.font-weight.bold}",
              "cds-g0": "400",
              "cds-g10": "400",
              "cds-g90": "400",
              "cds-g100": "400"
            }
          }
        }
      },
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "0.2",
          "unit": "s"
        }
      }
    }
  }
}
{
  "form": {
    "control": {
      "base": {
        "foreground": {
          "color": {
            "$type": "color",
            "$value": "{foreground.color.strong}",
            "group": "components"
          }
        },
        "surface": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{surface.color.interactive}",
              "group": "components"
            },
            "hover": {
              "$type": "color",
              "$value": "{surface.color.interactive-hover}",
              "group": "components"
            }
          }
        },
        "border": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.neutral-400}",
              "group": "components",
              "$modes": {
                "default": "{core.color.neutral-400}",
                "cds-g0": "{carbon.themes.white.borderStrong01}",
                "cds-g10": "{carbon.themes.g10.borderStrong01}",
                "cds-g90": "{carbon.themes.g90.borderStrong01}",
                "cds-g100": "{carbon.themes.g100.borderStrong01}"
              }
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.neutral-500}",
              "group": "components"
            }
          }
        },
        "placeholder": {
          "foreground": {
            "color": {
              "$type": "color",
              "$value": "{foreground.color.faint}",
              "group": "components",
              "$modes": {
                "default": "{foreground.color.faint}",
                "cds-g0": "{carbon.themes.white.textPlaceholder}",
                "cds-g10": "{carbon.themes.g10.textPlaceholder}",
                "cds-g90": "{carbon.themes.g90.textPlaceholder}",
                "cds-g100": "{carbon.themes.g100.textPlaceholder}"
              }
            }
          }
        }
      },
      "checked": {
        "foreground": {
          "color": {
            "$type": "color",
            "$value": "{foreground.color.high-contrast}",
            "group": "components"
          }
        },
        "surface": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.blue-200}",
              "group": "components"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.blue-300}",
              "group": "components"
            }
          }
        },
        "border": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.blue-300}",
              "group": "components"
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.blue-400}",
              "group": "components"
            }
          }
        }
      },
      "invalid": {
        "border": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.red-300}",
              "group": "components",
              "$modes": {
                "default": "{core.color.red-300}",
                "cds-g0": "{carbon.themes.white.supportError}",
                "cds-g10": "{carbon.themes.g10.supportError}",
                "cds-g90": "{carbon.themes.g90.supportError}",
                "cds-g100": "{carbon.themes.g100.supportError}",
                "comment": "Carbon uses outline instead of a border color change"
              }
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.red-400}",
              "group": "components",
              "$modes": {
                "default": "{core.color.red-400}",
                "cds-g0": "{carbon.themes.white.supportError}",
                "cds-g10": "{carbon.themes.g10.supportError}",
                "cds-g90": "{carbon.themes.g90.supportError}",
                "cds-g100": "{carbon.themes.g100.supportError}"
              }
            }
          }
        }
      },
      "readonly": {
        "foreground": {
          "color": {
            "$type": "color",
            "$value": "{foreground.color.primary}",
            "group": "components"
          }
        },
        "surface": {
          "color": {
            "$type": "color",
            "$value": "{surface.color.strong}",
            "group": "components"
          }
        },
        "border": {
          "color": {
            "$type": "color",
            "$value": "{border.color.faint}",
            "group": "components"
          }
        }
      },
      "disabled": {
        "foreground": {
          "color": {
            "$type": "color",
            "$value": "{foreground.color.disabled}",
            "group": "components"
          }
        },
        "surface": {
          "color": {
            "$type": "color",
            "$value": "{surface.color.interactive-disabled}",
            "group": "components"
          }
        },
        "border": {
          "color": {
            "$type": "color",
            "$value": "{border.color.primary}",
            "group": "components"
          }
        }
      }
    }
  }
}

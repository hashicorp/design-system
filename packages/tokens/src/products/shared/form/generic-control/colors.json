              "$type": "color",
              "$value": "{core.color.blue-300}",
              "group": "components",
              "$modes": {
                "default": "{core.color.blue-300}",
                "cds-g0": "{carbon.themes.white.iconPrimary}",
                "cds-g10": "{carbon.themes.g10.iconPrimary}",
                "cds-g90": "{carbon.themes.g90.iconPrimary}",
                "cds-g100": "{carbon.themes.g100.iconPrimary}"
              }
            },
            "disabled": {
              "$type": "color",
              "$value": "{border.color.primary}",
              "group": "components",
              "$modes": {
                "default": "{border.color.primary}",
                "cds-g0": "{carbon.themes.white.iconDisabled}",
                "cds-g10": "{carbon.themes.g10.iconDisabled}",
                "cds-g90": "{carbon.themes.g90.iconDisabled}",
                "cds-g100": "{carbon.themes.g100.iconDisabled}"
              }
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.blue-400}",
              "group": "components",
              "$modes": {
                "default": "{core.color.blue-400}",
                "cds-g0": "{carbon.themes.white.iconPrimary}",
                "cds-g10": "{carbon.themes.g10.iconPrimary}",
                "cds-g90": "{carbon.themes.g90.iconPrimary}",
                "cds-g100": "{carbon.themes.g100.iconPrimary}"
              }
            }
          }
        }
      },
      "unchecked": {
        "border": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.neutral-400}",
              "group": "components",
              "$modes": {
                "default": "{core.color.neutral-400}",
                "cds-g0": "{carbon.themes.white.iconPrimary}",
                "cds-g10": "{carbon.themes.g10.iconPrimary}",
                "cds-g90": "{carbon.themes.g90.iconPrimary}",
                "cds-g100": "{carbon.themes.g100.iconPrimary}"

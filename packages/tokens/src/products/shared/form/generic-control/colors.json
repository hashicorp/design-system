        },
        "surface": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{surface.color.interactive}",
              "group": "components",
              "$modes": {
                "default": "{surface.color.interactive}",
                "cds-g0": "transparent",
                "cds-g10": "transparent",
                "cds-g90": "transparent",
                "cds-g100": "transparent"

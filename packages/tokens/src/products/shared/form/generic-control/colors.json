            "disabled": {
              "$type": "color",
              "$value": "{surface.color.interactive-disabled}",
              "group": "components",
              "$modes": {
                "default": "{surface.color.interactive-disabled}",
                "cds-g0": "transparent",
                "cds-g10": "transparent",
                "cds-g90": "transparent",
                "cds-g100": "transparent"

{
  "form": {
    "control": {
      "base": {
        "foreground": {
          "color": {
            "$type": "color",
            "$value": "{foreground.color.strong}",
            "group": "components"
          }
        },
        "surface": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{surface.color.interactive}",
              "group": "components"
            },
            "hover": {
              "$type": "color",
              "$value": "{surface.color.interactive-hover}",
              "group": "components",
              "$modes": {
                "default": "{surface.color.interactive-hover}",
                "cds-g0": "{carbon.themes.white.field01}",
                "cds-g10": "{carbon.themes.g10.field01}",
                "cds-g90": "{carbon.themes.g90.field01}",
                "cds-g100": "{carbon.themes.g100.field01}"
              }
            }
          }
        },
        "border": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.neutral-400}",
              "group": "components",
              "$modes": {
                "default": "{core.color.neutral-400}",
                "cds-g0": "{carbon.themes.white.borderStrong01}",
                "cds-g10": "{carbon.themes.g10.borderStrong01}",
                "cds-g90": "{carbon.themes.g90.borderStrong01}",
                "cds-g100": "{carbon.themes.g100.borderStrong01}"
              }
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.neutral-500}",
              "group": "components",
              "$modes": {
                "default": "{core.color.neutral-500}",
                "cds-g0": "{carbon.themes.white.borderStrong01}",
                "cds-g10": "{carbon.themes.g10.borderStrong01}",
                "cds-g90": "{carbon.themes.g90.borderStrong01}",
                "cds-g100": "{carbon.themes.g100.borderStrong01}"
              }
            }
          }
        },
        "placeholder": {
          "foreground": {
            "color": {
              "default": {
                "$type": "color",
                "$value": "{foreground.color.faint}",
                "group": "components",
                "$modes": {
                  "default": "{foreground.color.faint}",
                  "cds-g0": "{carbon.themes.white.textPlaceholder}",
                  "cds-g10": "{carbon.themes.g10.textPlaceholder}",
                  "cds-g90": "{carbon.themes.g90.textPlaceholder}",
                  "cds-g100": "{carbon.themes.g100.textPlaceholder}"
                }
              },
              "disabled": {
                "$type": "color",
                "$value": "{foreground.color.disabled}",
                "group": "components",
                "$modes": {
                  "default": "{foreground.color.disabled}",
                  "cds-g0": "{carbon.themes.white.textDisabled}",
                  "cds-g10": "{carbon.themes.g10.textDisabled}",
                  "cds-g90": "{carbon.themes.g90.textDisabled}",
                  "cds-g100": "{carbon.themes.g100.textDisabled}"
                }
              }
            }
          }
        }
      },
      "checked": {
        "foreground": {
          "color": {
            "$type": "color",
            "$value": "{foreground.color.high-contrast}",
            "group": "components",
            "$modes": {
              "default": "{foreground.color.high-contrast}",
              "cds-g0": "{carbon.themes.white.textPrimary}",
              "cds-g10": "{carbon.themes.g10.textPrimary}",
              "cds-g90": "{carbon.themes.g90.textPrimary}",
              "cds-g100": "{carbon.themes.g100.textPrimary}"

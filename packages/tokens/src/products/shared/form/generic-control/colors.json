            "hover": {
              "$type": "color",
              "$value": "{surface.color.interactive-hover}",
              "group": "components",
              "$modes": {
                "default": "{surface.color.interactive-hover}",
                "cds-g0": "transparent",
                "cds-g10": "transparent",
                "cds-g90": "transparent",
                "cds-g100": "transparent"
              }
            }
          }
        }
      },
      "invalid": {
        "border": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{core.color.red-300}",
              "group": "components",
              "$modes": {
                "default": "{core.color.red-300}",
                "cds-g0": "{carbon.themes.white.supportError}",
                "cds-g10": "{carbon.themes.g10.supportError}",
                "cds-g90": "{carbon.themes.g90.supportError}",
                "cds-g100": "{carbon.themes.g100.supportError}",
                "comment": "Carbon uses outline instead of a border color change"
              }
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.red-400}",
              "group": "components",
              "$modes": {
                "default": "{core.color.red-400}",
                "cds-g0": "{carbon.themes.white.supportError}",
                "cds-g10": "{carbon.themes.g10.supportError}",
                "cds-g90": "{carbon.themes.g90.supportError}",
                "cds-g100": "{carbon.themes.g100.supportError}"

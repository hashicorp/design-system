{
  "form": {
    "radio-card-group": {
      "gap": {
        "$type": "dimension",
        "$value": "16",
        "unit": "px"
      }
    },
    "radio-card": {
      "surface": {
        "color": {
          "active": {
            "comment": "TODO: Carbon background colors are incorrect. Tried to make same value as Figma variable but looks wrong",
            "$type": "color",
            "$value": "{surface.color.primary}",
            "$modes": {
              "default": "{surface.color.primary}",
              "cds-g0": "{carbon.themes.white.layerHover01}",
              "cds-g10": "{carbon.themes.g10.layerHover01}",
              "cds-g90": "{carbon.themes.g90.layerHover01}",
              "cds-g100": "{carbon.themes.g100.layerHover01}"
            }
          },
          "disabled": {
            "$type": "color",
            "$value": "{surface.color.interactive-disabled}",
            "$modes": {
              "default": "{surface.color.interactive-disabled}",
              "cds-g0": "{carbon.themes.white.layerHover01}",
              "cds-g10": "{carbon.themes.g10.layerHover01}",
              "cds-g90": "{carbon.themes.g90.layerHover01}",
              "cds-g100": "{carbon.themes.g100.layerHover01}"
            }
          }
        }
      },
      "border": {
        "width": {
          "$type": "dimension",
          "$value": "1",
          "unit": "px"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{border.radius.medium}",
          "unit": "px"
        },
        "color": {
          "default": {
            "$type": "color",
            "$value": "{border.color.primary}",
            "$modes": {
              "default": "{border.color.primary}",
              "cds-g0": "transparent",
              "cds-g10": "transparent",
              "cds-g90": "transparent",
              "cds-g100": "transparent"
            }
          },
          "checked": {
            "default": {
              "$type": "color",
              "$value": "{core.color.blue-300}",
              "$modes": {
                "default": "{core.color.blue-300}",
                "cds-g0": "{carbon.themes.white.borderInverse}",
                "cds-g10": "{carbon.themes.g10.borderInverse}",
                "cds-g90": "{carbon.themes.g90.borderInverse}",
                "cds-g100": "{carbon.themes.g100.borderInverse}"
              }
            },
            "hover": {
              "$type": "color",
              "$value": "{core.color.blue-400}",
              "$modes": {
                "default": "{core.color.blue-400}",
                "cds-g0": "{carbon.themes.white.borderInverse}",
                "cds-g10": "{carbon.themes.g10.borderInverse}",
                "cds-g90": "{carbon.themes.g90.borderInverse}",
                "cds-g100": "{carbon.themes.g100.borderInverse}"
              }
            },
            "disabled": {
              "$type": "color",
              "$value": "",
              "$modes": {
                "default": "",
                "cds-g0": "{carbon.themes.white.borderDisabled}",
                "cds-g10": "{carbon.themes.g10.borderDisabled}",
                "cds-g90": "{carbon.themes.g90.borderDisabled}",
                "cds-g100": "{carbon.themes.g100.borderDisabled}"
              }
            }
          },
          "focus": {
            "$type": "color",
            "$value": "{focus.color.action.internal}",
            "$modes": {
              "default": "{focus.color.action.internal}",
              "cds-g0": "pink",
              "cds-g10": "pink",
              "cds-g90": "pink",
              "cds-g100": "pink"
            }
          }
        }
      },
      "content-padding": {
        "$type": "dimension",
        "$value": "24",
        "unit": "px",
        "$modes": {
          "default": "24",
          "cds-g0": "16",
          "cds-g10": "16",
          "cds-g90": "16",
          "cds-g100": "16"
        }
      },
      "control": {
        "comment": "This is the actual radio button control",
        "size": {
          "$type": "dimension",
          "$value": "16",
          "unit": "px"
        }
      },
      "control-wrapper": {
        "surface": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{surface.color.faint}",
              "$modes": {
                "default": "{surface.color.faint}",
                "cds-g0": "transparent",
                "cds-g10": "transparent",
                "cds-g90": "transparent",
                "cds-g100": "transparent"
              }
            },
            "checked": {
              "$type": "color",
              "$value": "{surface.color.action}",
              "$modes": {
                "default": "{surface.color.action}",
                "cds-g0": "transparent",
                "cds-g10": "transparent",
                "cds-g90": "transparent",
                "cds-g100": "transparent"
              }
            },
            "disabled": {
              "$type": "color",
              "$value": "{surface.color.interactive-disabled}",
              "$modes": {
                "default": "{surface.color.interactive-disabled}",
                "cds-g0": "transparent",
                "cds-g10": "transparent",
                "cds-g90": "transparent",
                "cds-g100": "transparent"
              }
            }
          }
        },
        "border": {
          "color": {
            "default": {
              "$type": "color",
              "$value": "{border.color.primary}",
              "$modes": {
                "default": "{border.color.primary}",
                "cds-g0": "{carbon.themes.white.borderSubtle02}",
                "cds-g10": "{carbon.themes.g10.borderSubtle02}",
                "cds-g90": "{carbon.themes.g90.borderSubtle02}",
                "cds-g100": "{carbon.themes.g100.borderSubtle02}"
              }
            },
            "action": {
              "$type": "color",
              "$value": "{border.color.action}",
              "$modes": {
                "default": "{border.color.action}",
                "cds-g0": "{carbon.themes.white.borderSubtle01}",
                "cds-g10": "{carbon.themes.g10.borderSubtle01}",
                "cds-g90": "{carbon.themes.g90.borderSubtle01}",
                "cds-g100": "{carbon.themes.g100.borderSubtle01}"
              }
            },
            "disabled": {
              "$type": "color",
              "$value": "{border.color.primary}",
              "$modes": {
                "default": "{border.color.primary}",
                "cds-g0": "{carbon.color.gray.30}",
                "cds-g10": "{carbon.color.gray.20}",
                "cds-g90": "{carbon.color.gray.60}",
                "cds-g100": "{carbon.color.gray.70}"
              }
            }
          }
        },
        "padding": {
          "$type": "dimension",
          "$value": "8",
          "unit": "px"
        }
      },
      "description": {
        "typography": {
          "font-size": {
            "$type": "font-size",
            "$value": "{typography.body-100.font-size}",
            "unit": "px",
            "$modes": {
              "default": "{typography.body-100.font-size}",
              "cds-g0": "{carbon.typography.bodyCompact01.font-size}",
              "cds-g10": "{carbon.typography.bodyCompact01.font-size}",
              "cds-g90": "{carbon.typography.bodyCompact01.font-size}",
              "cds-g100": "{carbon.typography.bodyCompact01.font-size}"
            }
          }
        }
      },
      "label": {
        "foreground": {
          "color": {
            "comment": "Note: this is 'label' text within the RadioCard, not a form label itself. Called a 'title' in Figma",
            "$type": "color",
            "$value": "{form.label.foreground.color}",
            "$modes": {
              "default": "{form.label.foreground.color}",
              "cds-g0": "{foreground.color.strong}",
              "cds-g10": "{foreground.color.strong}",
              "cds-g90": "{foreground.color.strong}",
              "cds-g100": "{foreground.color.strong}"
            }
          }
        },
        "typography": {
          "font-size": {
            "$type": "font-size",
            "$value": "{typography.display-300.font-size}",
            "unit": "px",
            "$modes": {
              "default": "{typography.display-300.font-size}",
              "cds-g0": "{carbon.typography.bodyCompact01.font-size}",
              "cds-g10": "{carbon.typography.bodyCompact01.font-size}",
              "cds-g90": "{carbon.typography.bodyCompact01.font-size}",
              "cds-g100": "{carbon.typography.bodyCompact01.font-size}"
            }
          },
          "font-weight": {
            "$type": "font-weight",
            "$value": "{typography.font-weight.bold}",
            "$modes": {
              "default": "{typography.font-weight.bold}",
              "cds-g0": "{carbon.typography.font-weight.regular}",
              "cds-g10": "{carbon.typography.font-weight.regular}",
              "cds-g90": "{carbon.typography.font-weight.regular}",
              "cds-g100": "{carbon.typography.font-weight.regular}"
            }
          }
        }
      },
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "0.2",
          "unit": "s"
        }
      }
    }
  }
}
    "progress-bar": {
      "height": {
        "$type": "dimension",
        "$value": "4",
        "unit": "px",
        "$modes": {
          "default": "4",
          "cds-g0": "2",
          "cds-g10": "2",
          "cds-g90": "2",
          "cds-g100": "2"
        }

          "complete": {
            "default": {
              "$type": "color",
              "$value": "{color.palette.neutral-700}",
              "$modes": {
                "default": "{color.palette.neutral-700}",
                "cds-g0": "{color.palette.neutral-700}",
                "cds-g10": "{color.palette.neutral-700}",
                "cds-g90": "{color.palette.neutral-100}",
                "cds-g100": "{color.palette.neutral-100}"
              }
            },
            "interactive": {
              "$type": "color",
              "$value": "{color.palette.blue-200}",
              "$modes": {
                "default": "{color.palette.blue-200}",
                "cds-g0": "{carbon.themes.white.interactive}",
                "cds-g10": "{carbon.themes.g10.interactive}",
                "cds-g90": "{carbon.themes.g90.interactive}",
                "cds-g100": "{carbon.themes.g100.interactive}"
              }
            }
          }
        }

            "$type": "font-size",
            "$value": "{typography.body-100.font-size}",
            "$modes": {
              "default": "{typography.body-100.font-size}",
              "cds-g0": {
                "$value": "0.75",
                "unit": "rem"
              },
              "cds-g10": {
                "$value": "0.75",
                "unit": "rem"
              },
              "cds-g90": {
                "$value": "0.75",
                "unit": "rem"
              },
              "cds-g100": {
                "$value": "0.75",
                "unit": "rem"
              }
            }
          }
        },
      },

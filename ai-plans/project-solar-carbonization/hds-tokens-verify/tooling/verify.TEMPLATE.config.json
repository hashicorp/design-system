{
  "$comment": "TEMPLATE — copy to `verify.<repo>.config.json` next to this file and edit for each target codebase (usually only `roots`, `extensions`, `excludeGlobs`). Run with: node <this-folder>/verify-tokens.mjs --config <this-folder>/verify.<repo>.config.json --root /path/to/target-repo. `roots` are relative to --root. The official token list is resolved from the target repo's installed `tokensPackage` (use `tokensResolveFrom` for monorepos where it is installed under a sub-package, or `tokensCssOverride` / --tokens-css to point at a file). `legacyPrefix` reports leftover pre-6.0.0 `--token-*` usages (set to null to disable). Reports go to ./audit-reports/ next to the script unless --out is passed. See ../README.md.",
  "$commentAllowlist": "`allowlist` = names that use the audited prefix but are NOT in tokens.css: the `--hds-var-*` runtime variables set by @hashicorp/design-system-components (complete as of components on HDS main, 2026-10-19). Refresh it if a newer components version adds/removes `--hds-var-*` variables, and add any consumer-specific exceptions here.",
  "tokensPackage": "@hashicorp/design-system-tokens",
  "tokensCssPath": "dist/products/css/tokens.css",
  "tokensCssOverride": null,
  "tokensResolveFrom": null,
  "prefix": "--hds-",
  "legacyPrefix": "--token-",
  "roots": [
    "app",
    "addon",
    "src",
    "styles"
  ],
  "extensions": [
    "scss",
    "css",
    "gts",
    "gjs",
    "hbs",
    "ts",
    "js"
  ],
  "excludeGlobs": [
    "**/dist/**",
    "**/tmp/**",
    "**/node_modules/**",
    "**/.git/**",
    "**/*.map",
    "**/*.md"
  ],
  "ignoreComments": true,
  "reportSubdir": null,
  "reportGroups": null,
